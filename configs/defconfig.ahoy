#
# Ahoy DTU - sdkconfig-Ergaenzungen fuer esp32-arduino-lib-builder
# Stand: getestet per Hybrid Compile (pioarduino, IDF 5.5.x) auf ESP32 und ESP32-S3
#
# Diese Datei muss NACH defconfig.common und den Chip-/Speicher-defconfigs
# eingelesen werden, damit ihre Werte nicht ueberschrieben werden.
#

#
# Netzwerk / lwIP
#
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_IPV4_NAPT=n
CONFIG_LWIP_IP_FORWARD=n
CONFIG_LWIP_PPP_SUPPORT=n
CONFIG_LWIP_ESP_LWIP_ASSERT=n
CONFIG_VFS_SUPPORT_TERMIOS=n

# WICHTIG: Ohne PPP muss Bridge an bleiben!
# Sonst ist LWIP_ESP_NETIF_DATA=0, esp_netif nutzt netif->state und haelt die
# WireGuard-Schnittstelle fuer eine eigene -> Absturz (memcmp auf NULL) bzw.
# stilles Ueberschreiben von Speicher. Siehe lwipopts.h, LWIP_ESP_NETIF_DATA.
CONFIG_ESP_NETIF_BRIDGE_EN=y

#
# mDNS
#
CONFIG_MDNS_ENABLE_CONSOLE_CLI=n
CONFIG_MDNS_ENABLE_BROWSE=n
CONFIG_MDNS_MAX_SERVICES=4

#
# WLAN
#
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_SAE_PK=n
CONFIG_ESP_WIFI_FTM_ENABLE=n
CONFIG_ESP_WIFI_CSI_ENABLED=n
CONFIG_ESP_WIFI_GCMP_SUPPORT=n
CONFIG_ESP_WIFI_GMAC_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT=n
# Stufe 2, erst nach Pruefung aller Router aktivieren:
# CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n

#
# Bluetooth
#
CONFIG_BT_ENABLED=n

#
# mbedTLS
#
CONFIG_MBEDTLS_CAMELLIA_C=n
CONFIG_MBEDTLS_CHACHA20_C=n
CONFIG_MBEDTLS_POLY1305_C=n
CONFIG_MBEDTLS_CHACHAPOLY_C=n
CONFIG_MBEDTLS_ECJPAKE_C=n
CONFIG_MBEDTLS_KEY_EXCHANGE_ECJPAKE=n

#
# System / Debug
#
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT=y
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=y
CONFIG_FREERTOS_ENABLE_TASK_SNAPSHOT=n
CONFIG_ESP_PHY_ENABLE_VERSION_PRINT=n
CONFIG_HEAP_POISONING_DISABLED=y

#
# Zu entfernende Komponenten (nicht per defconfig, sondern im
# idf_component.yml bzw. per Builder-Option):
#   espressif/esp-modbus
#   espressif/esp_modem
#
