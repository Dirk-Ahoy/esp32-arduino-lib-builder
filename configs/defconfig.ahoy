#
# Ahoy DTU - sdkconfig-Ergaenzungen fuer esp32-arduino-lib-builder
# Fork Dirk-Ahoy/esp32-arduino-lib-builder, Branch ahoy-3.3.12 (Arduino 3.3.x / IDF 5.5)
# Gilt fuer ESP32 und ESP32-S3. Nur-ESP32-Werte stehen in defconfig.ahoy_esp32.
#
# Diese Datei muss NACH defconfig.common und den Chip-/Speicher-defconfigs
# eingelesen werden, damit ihre Werte nicht ueberschrieben werden.
#

#
# Netzwerk / lwIP
#
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_IPV4_NAPT=n
CONFIG_LWIP_IP_FORWARD=n
CONFIG_LWIP_PPP_SUPPORT=n
CONFIG_LWIP_ESP_LWIP_ASSERT=n
CONFIG_VFS_SUPPORT_TERMIOS=n

# WICHTIG: Ohne PPP muss Bridge an bleiben!
# Sonst ist LWIP_ESP_NETIF_DATA=0, esp_netif nutzt netif->state und haelt die
# WireGuard-Schnittstelle fuer eine eigene -> Absturz (memcmp auf NULL) bzw.
# stilles Ueberschreiben von Speicher. Siehe lwipopts.h, LWIP_ESP_NETIF_DATA.
CONFIG_ESP_NETIF_BRIDGE_EN=y

# Core Locking wie im offiziellen Paket. Wurde bisher von Matter
# (USE_TCPIP_CORE_LOCK_FOR_THREAD_SAFETY) erzwungen.
CONFIG_LWIP_TCPIP_CORE_LOCKING=y
CONFIG_LWIP_CHECK_THREAD_SAFETY=y
# OFFEN: Der Thread-Safety-Check meldet sich ueber LWIP_ASSERT. Mit
# CONFIG_LWIP_ESP_LWIP_ASSERT=n (oben) prueft er vermutlich nichts mehr.
# Test-Build: beide an. Release-Build: beide aus. CORE_LOCKING bleibt immer an.

#
# mDNS
#
CONFIG_MDNS_ENABLE_CONSOLE_CLI=n
CONFIG_MDNS_ENABLE_BROWSE=n
CONFIG_MDNS_MAX_SERVICES=4

#
# WLAN
#
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_SAE_PK=n
CONFIG_ESP_WIFI_FTM_ENABLE=n
CONFIG_ESP_WIFI_CSI_ENABLED=n
CONFIG_ESP_WIFI_GCMP_SUPPORT=n
CONFIG_ESP_WIFI_GMAC_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT=n
# Stufe 2, erst nach Pruefung aller Router aktivieren:
# CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n

#
# Ethernet: nur W5500 (EMAC beim ESP32 siehe defconfig.ahoy_esp32)
# CONFIG_ETH_ENABLED und W5500 muessen an bleiben (auch fuer mDNS auf ETH)
#
CONFIG_ETH_SPI_ETHERNET_DM9051=n
CONFIG_ETH_SPI_ETHERNET_KSZ8851SNL=n

#
# Bluetooth
#
CONFIG_BT_ENABLED=n

#
# mbedTLS
#
CONFIG_MBEDTLS_CAMELLIA_C=n
CONFIG_MBEDTLS_CHACHA20_C=n
CONFIG_MBEDTLS_POLY1305_C=n
CONFIG_MBEDTLS_CHACHAPOLY_C=n
CONFIG_MBEDTLS_ECJPAKE_C=n
CONFIG_MBEDTLS_KEY_EXCHANGE_ECJPAKE=n

#
# System / Debug
#
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT=y
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=y
CONFIG_FREERTOS_ENABLE_TASK_SNAPSHOT=n
CONFIG_ESP_PHY_ENABLE_VERSION_PRINT=n
CONFIG_HEAP_POISONING_DISABLED=y

# ISR-Stack wie im offiziellen Paket. Ohne Core-Dump faellt er sonst auf 1536.
CONFIG_FREERTOS_ISR_STACKSIZE=2096

#
# Stacks / FreeRTOS
#
# common setzt 8192. Ahoy nutzt esp_timer/Ticker nicht direkt.
# Nach dem Flashen High-Water-Mark des Tasks "esp_timer" pruefen.
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096
# Task-Statistik: von Ahoy nicht genutzt (kein vTaskList/uxTaskGetSystemState)
CONFIG_FREERTOS_USE_TRACE_FACILITY=n
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=n
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=n

#
# ESP Insights / Diagnose - von Ahoy nicht genutzt
# (Komponente zusaetzlich aus dem Build nehmen, siehe unten)
#
CONFIG_ESP_INSIGHTS_ENABLED=n
CONFIG_DIAG_ENABLE_METRICS=n
CONFIG_DIAG_ENABLE_HEAP_METRICS=n
CONFIG_DIAG_ENABLE_WIFI_METRICS=n
CONFIG_DIAG_ENABLE_VARIABLES=n
CONFIG_DIAG_ENABLE_NETWORK_VARIABLES=n
CONFIG_DIAG_USE_EXTERNAL_LOG_WRAP=n

#
# Stufe 2 - einzeln aktivieren und testen:
#
# Ahoy baut mit -fno-exceptions; danach ist "-fexceptions" in build_unflags ueberfluessig
# CONFIG_COMPILER_CXX_EXCEPTIONS=n
# Je Puffer ca. 1,6 KB fester Heap (common: 8); kostet etwas Durchsatz (Web-UI, OTA testen)
# CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
# Nur Release: kein Stack-Canary (-fstack-protector), Ueberlaeufe fallen dann nicht mehr sofort auf
# CONFIG_COMPILER_STACK_CHECK_MODE_NONE=y

#
# Zu entfernende Komponenten (nicht per defconfig, sondern im
# idf_component.yml bzw. per Builder-Option):
#   espressif/esp-modbus
#   espressif/esp_modem
#   espressif/esp_insights (inkl. esp_diagnostics), espressif/esp_rainmaker
#
